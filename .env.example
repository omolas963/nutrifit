# Puerto del servidor backend (en la nube se asigna automáticamente)
PORT=5000
NODE_ENV=production

# Directorio de persistencia para la base de datos (en la nube o volumen persistente)
DATA_DIR=./server/data

# Proveedor de Inteligencia Artificial activo: "gemini", "openai" o "claude"
AI_PROVIDER=gemini

# Claves de API de los proveedores (configura la del proveedor que elijas en los Secretos de la nube)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# USDA FoodData Central API Key (Opcional)
USDA_API_KEY=DEMO_KEY
