<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Header: NutriFit Brand -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/widget_button_bg"
            android:text="N"
            android:textColor="#1F1B16"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NutriFit"
            android:textColor="#1F1B16"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_updated_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoy"
            android:textColor="#85786B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Calories Hero Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_kcal_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.230 kcal"
            android:textColor="#1F1B16"
            android:textSize="22sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_kcal_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="restantes hoy (0 consumidas)"
            android:textColor="#66594C"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Bottom Metrics Row: Steps & Water -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Steps Pill -->
        <LinearLayout
            android:id="@+id/widget_steps_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_steps_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 pasos"
                android:textColor="#1F1B16"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Water Pill -->
        <LinearLayout
            android:id="@+id/widget_water_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:layout_marginEnd="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="11sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_water_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.0 L"
                android:textColor="#1F1B16"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Open / Add Button -->
        <TextView
            android:id="@+id/widget_add_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_button_bg"
            android:text="+"
            android:textColor="#1F1B16"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
